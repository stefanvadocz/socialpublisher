# PR Social Publisher — example environment.
# Copy to .env (`cp .env.example .env`). All defaults run keyless on mocks + RSS.

# --- Core ---
APP_ENV=local
DATABASE_URL=sqlite:///./app.db
TIMEZONE=America/Toronto
DAILY_RUN_HOUR=7
# Insert demo posts on startup if the DB is empty (great for a fresh deploy).
SEED_ON_START=false

# --- Provider selection (mock/rss = no keys needed) ---
SEARCH_PROVIDER=rss          # rss | firecrawl | exa
CAPTION_PROVIDER=mock        # mock | claude
IMAGE_PROVIDER=mock          # mock | unsplash | pexels
PUBLISHER=mock               # mock | meta

# --- AI captions (Anthropic Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Web search (optional, only if SEARCH_PROVIDER != rss) ---
FIRECRAWL_API_KEY=
EXA_API_KEY=
# Comma-separated RSS feeds. Leave blank to use the built-in PR/news feed list.
RSS_FEEDS=

# --- Stock images (optional, only if IMAGE_PROVIDER != mock) ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- Meta publishing (later; only if PUBLISHER=meta) ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v21.0

# --- Ranking weights (optional overrides) ---
RANK_W_AUTHORITY=0.45
RANK_W_PR_OUTLET=0.15
RANK_W_RECENCY=0.20
RANK_W_KEYWORD=0.20
MAX_DAILY_SUGGESTIONS=8
MAX_ARTICLE_AGE_HOURS=72
